# Django core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Railway provides DATABASE_URL automatically.
# Leave blank locally to use SQLite (db.sqlite3).
DATABASE_URL=

# CSRF — comma-separated list of full origins (scheme + host) for admin login
# Example: https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Telegram bot — see SETUP.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# RevenueCat REST API — secret key, used by the attribution gateway
# (POST /api/v1/attribution/fetch/). Create one in RC dashboard:
# Project settings → API keys → New secret API key (label e.g.
# "attribution-gateway"). NEVER commit a real value here.
REVENUECAT_SECRET_API_KEY=

# Anthropic — server-side proxy for script optimize/split (ai app).
# This key must exist ONLY here and in Railway, never in the iOS bundle.
ANTHROPIC_API_KEY=
# Kill switch: set to false to make /api/v1/ai/* return 503 immediately.
AI_ENABLED=true

# Auphonic — server-side proxy for "Studio Sound" (audio app).
# auphonic.com → Account Settings → API Keys. Never in the iOS bundle.
AUPHONIC_API_KEY=
# Kill switch: set to false to make POST /api/v1/audio/enhance/ return 503.
AUDIO_ENHANCE_ENABLED=true
# Billed minutes per UTC day (Auphonic bills ≥3 min per production).
AUDIO_ENHANCE_USER_DAILY_MINUTES=30
AUDIO_ENHANCE_GLOBAL_DAILY_MINUTES=60
